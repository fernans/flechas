<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="TestAppConsole" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug Win32">
				<Option output="TestAppConsole" prefix_auto="1" extension_auto="1" />
				<Option object_output="Debug Win32" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-DWIN32" />
					<Add option="-D_DEBUG" />
					<Add option="-D_CONSOLE" />
					<Add option="-Wall" />
					<Add option="-g" />
					<Add option="-O0" />
					<Add directory="$(SM_API_PATH)\include" />
				</Compiler>
				<ResourceCompiler>
					<Add directory="$(SM_API_PATH)\include" />
				</ResourceCompiler>
				<Linker>
					<Add library="smft32" />
					<Add directory="$(SM_API_PATH)\bin" />
				</Linker>
				<ExtraCommands>
					<Add after="postbuild.bat $(SM_API_PATH)\bin bin_dbg Debug Win32" />
				</ExtraCommands>
			</Target>
			<Target title="Release Win32">
				<Option output="TestAppConsole" prefix_auto="1" extension_auto="1" />
				<Option object_output="Release Win32" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-DWIN32" />
					<Add option="-DNDEBUG" />
					<Add option="-D_CONSOLE" />
					<Add option="-Wall" />
					<Add directory="$(SM_API_PATH)\include" />
				</Compiler>
				<ResourceCompiler>
					<Add directory="$(SM_API_PATH)\include" />
				</ResourceCompiler>
				<Linker>
					<Add library="smft32" />
					<Add directory="$(SM_API_PATH)\bin" />
				</Linker>
				<ExtraCommands>
					<Add after="postbuild.bat $(SM_API_PATH)\bin bin Release Win32" />
				</ExtraCommands>
			</Target>
		</Build>
		<Compiler>
			<Add option="-D_MSC_VER" />
		</Compiler>
		<Unit filename="ReadMe.txt" />
		<Unit filename="TestAppConsole.cpp" />
		<Unit filename="lock.h" />
		<Unit filename="mutex.h" />
		<Unit filename="postbuild.bat" />
		<Unit filename="stdafx.cpp" />
		<Unit filename="stdafx.h" />
		<Unit filename="utils.h" />
		<Extensions>
			<code_completion />
			<envvars />
			<debugger />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
