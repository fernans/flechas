	<Configurations>
		<Configuration
			Name="Release|Win32"
			OutputDirectory="Release"
			IntermediateDirectory="Release"
			ConfigurationType="1"
			CharacterSet="2">
			<Tool
				Name="VCCLCompilerTool"
				AdditionalIncludeDirectories="..\..\..\..\..\include;..\..\..\..\..\source\utilities;..\..\..\..\..\source\common;&quot;..\..\..\..\..\source\applications\recognition-create_gallery&quot;"
